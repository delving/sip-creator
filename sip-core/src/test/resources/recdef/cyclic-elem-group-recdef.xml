<?xml version="1.0"?>
<!-- An elem-group whose member re-injects the same group: ancestor-skip only
     applies to template targets, so this recurses until the depth backstop,
     which must fail with a catchable exception instead of StackOverflowError. -->
<record-definition prefix="test" version="0.0.0">
    <namespaces>
        <namespace prefix="test" uri="http://test.example.org/" schema="http://test.example.org/test.xsd"/>
    </namespaces>

    <attrs>
        <attr tag="id"/>
    </attrs>

    <elem-groups>
        <elem-group name="spiral">
            <elem tag="wrapper" elemGroups="spiral"/>
        </elem-group>
    </elem-groups>

    <root tag="root">
        <elem tag="thing" attrs="id" elemGroups="spiral"/>
    </root>

    <field-markers/>
    <opts/>
</record-definition>
